{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Libria plugin manifest (draft API v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "apiVersion", "main", "permissions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$", "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 1 },
    "main": { "type": "string", "pattern": "^(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(?:js|mjs|cjs)$" },
    "description": { "type": "string", "maxLength": 1000 },
    "author": { "type": "string", "maxLength": 200 },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["document.read", "document.propose-edits", "network", "browser.open", "authorization.oauth", "secrets"] }
    },
    "networkOrigins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "permissions": { "contains": { "const": "network" } } } },
      "then": { "required": ["networkOrigins"], "properties": { "networkOrigins": { "minItems": 1 } } }
    }
  ]
}
