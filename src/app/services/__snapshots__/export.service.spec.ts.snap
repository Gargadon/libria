exports[`export format regression > keeps the print composition used by preview and PDF 1`] = `
"<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="author" content="Autora">
  <title>Libro de prueba</title>
  <style>
* { box-sizing: border-box; margin: 0; padding: 0; }

@page {
  size: 5in 8in;
  margin-top: 20mm;
  margin-bottom: 20mm;
}
@page :left {
  margin-left: 15mm;
  margin-right: 25mm;
}
@page :right {
  margin-left: 25mm;
  margin-right: 15mm;
}


@page :first {
  @top-left { content: none !important; }
  @top-center { content: none !important; }
  @top-right { content: none !important; }
  @bottom-left { content: none !important; }
  @bottom-center { content: none !important; }
  @bottom-right { content: none !important; }
}
      
@page {
  @top-center {
    content: "Libro de prueba";
    
        font-family: 'Lora', serif;
        font-size: 9pt;
        color: #555;
        font-weight: normal;
        font-style: normal;
      
    font-style: italic;
  }
}
        
@page {
  @bottom-center {
    content: counter(page);
    
        font-family: 'Lora', serif;
        font-size: 9pt;
        color: #555;
        font-weight: normal;
        font-style: normal;
      
  }
}
          

body {
  font-family: 'Lora', serif;
  font-size: 12pt;
  line-height: 1.6;
  color: #000;
  background: #fff;
}

/* ── Chapter separators ── */
.ch { break-before: page; break-inside: auto; }
.ch:first-child { break-before: auto; }
.ch--recto { break-before: recto; }

/* ── Paragraphs ── */
.kp-p {
  margin-top: 0.333em;
  text-align: left;
  
  break-inside: auto;
  widows: 2; orphans: 2;
  overflow-wrap: break-word;
}
.kp-p + .kp-p,
.kp-first + .kp-p {
  text-indent: 0.5cm;
  margin-top: 0.333em;
}
.kp-p:first-of-type { margin-top: 0; }

.kp-first {
  text-indent: 0;
  text-align: left;
  
  break-inside: avoid;
  widows: 2; orphans: 2;
}
.kp-first::first-line {
  font-variant: small-caps;
  letter-spacing: .04em;
}

.has-dropcap { display: flow-root; }
.has-dropcap::first-letter {
  font-family: 'Spectral', serif;
  float: left;
  font-size: calc(3 * 1.2em);
  line-height: .85;
  padding: 2pt 4pt 0 0;
}


/* ── Titles ── */
.kp-halftitle {
  font-family: 'Spectral', serif;
  font-size: 19.2pt;
  font-weight: bold; font-style: normal; text-decoration: none;
  text-align: center;
  line-height: 1.2;
  margin: 50pt 0 0;
  break-after: avoid;
}
.kp-title {
  font-family: 'Spectral', serif;
  font-size: 28.8pt;
  font-weight: bold; font-style: normal; text-decoration: none;
  text-align: center;
  line-height: 1.1;
  margin: 36pt 0 6pt;
  break-after: avoid;
}
.kp-sub {
  text-align: center;
  font-style: italic;
  font-size: 10.8pt;
  margin-bottom: 28pt;
  color: #3a3530;
  break-inside: avoid;
}
.kp-author {
  text-align: center;
  font-size: 10.2pt;
  letter-spacing: .12em;
  text-transform: uppercase;
  margin-bottom: 6pt;
  break-inside: avoid;
}
.kp-pub {
  text-align: center;
  font-size: 8.4pt;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: #5a554d;
  margin-top: 56pt;
  break-inside: avoid;
}
.kp-ded {
  text-align: center;
  font-style: italic;
  line-height: 1.8;
  margin: 48pt 16pt;
  break-inside: avoid;
}
.kp-chnum {
  font-family: 'Spectral', serif;
  font-size: 11.2pt;
  font-weight: bold; font-style: normal;
  letter-spacing: .28em;
  text-transform: uppercase;
  text-align: center;
  color: #5a554d;
  margin: 6pt 0 4pt;
  break-after: avoid;
}
.kp-chtitle {
  font-family: 'Spectral', serif;
  font-size: 16pt;
  font-weight: bold; font-style: normal; text-decoration: none;
  text-align: center;
  line-height: 1.2;
  margin: 0 0 22pt;
  break-after: avoid;
}
.kp-chtitle::after {
  content: "";
  display: block;
  width: 24pt;
  height: 0.5px;
  background: #1f1c18;
  margin: 8pt auto 0;
  opacity: .5;
}
.kp-h1 {
  font-family: 'Spectral', serif;
  font-size: 13.6pt;
  font-weight: bold; font-style: normal;
  text-align: center;
  margin: 0 0 14pt;
  break-after: avoid;
}
.kp-h2 {
  font-family: 'Spectral', serif;
  font-size: 11.5pt;
  font-weight: bold; font-style: normal;
  text-align: center;
  margin: 0 0 10pt;
  break-after: avoid;
}
.kp-h3 {
  font-family: 'Spectral', serif;
  font-size: 9.9pt;
  font-weight: bold; font-style: normal;
  text-align: center;
  margin: 0 0 8pt;
  break-after: avoid;
}

/* ── Other blocks ── */
.kp-break {
  text-align: center;
  margin: 1em 0;
  letter-spacing: .6em;
  font-size: 9.6pt;
  color: #5a554d;
  break-inside: avoid;
}
.kp-quote {
  margin: .5em 0;
  padding: .3em 1em;
  border-left: 2px solid #ccc;
  color: #5a554d;
  font-style: italic;
}
.kp-epigraph {
  text-align: center;
  margin: 1.2em 0;
  break-inside: avoid;
}
.kp-epigraph__q {
  font-style: italic;
  font-size: 0.9em;
  margin: 0;
}
.kp-epigraph__att {
  display: block;
  margin-top: 0.4em;
  font-size: 0.85em;
  color: #5a554d;
}
.kp-verse {
  font-family: 'Courier New', Courier, monospace;
  font-size: 0.85em;
  white-space: pre-line;
  line-height: 1.6;
  margin: 1em 0;
  break-inside: avoid;
}
.kp-code {
  background: #f5f3f1;
  padding: 1em;
  border-radius: 3px;
  font-family: 'Courier New', Courier, monospace;
  font-size: 0.8em;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.5;
  break-inside: avoid;
}
.kp-page-break {
  display: block;
  height: 0;
  break-after: page;
  page-break-after: always;
}
.kp-list {
  margin: 0.5em 0;
  padding-left: 1.5em;
}
.kp-list li {
  margin: 0.2em 0;
}
.kp-table-wrap {
  overflow-x: auto;
  margin: 0.8em 0;
}
.kp-table-wrap table {
  border-collapse: collapse;
  width: 100%;
}
.kp-table-wrap td {
  border: 1px solid #999;
  padding: 5px 7px;
  text-align: left;
  vertical-align: top;
  font-size: 0.9em;
}
.kp-fnpanel {
  margin-top: 30px;
  font-size: 11pt;
  color: #555;
}
.kp-fnpanel-rule {
  border: 0;
  border-top: 1px solid #ccc;
  margin-bottom: 12px;
}
.kp-fnpanel-item {
  margin-bottom: 6px;
  line-height: 1.4;
  display: flex;
  gap: 4px;
}
.kp-fnpanel-num {
  font-weight: 600;
  min-width: 18px;
  flex-shrink: 0;
}
.kp-fnpanel-text {
  flex: 1;
}
.kp-toc-heading {
  text-align: center;
  font-size: 1.2em;
  font-weight: bold;
  margin-bottom: 1.4em;
}
.kp-toc-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.kp-toc-li {
  display: flex;
  align-items: baseline;
  gap: 4px;
  padding: 3px 0;
  border-bottom: 1px dotted #ccc;
}
.kp-toc-link {
  color: inherit;
  display: flex;
  align-items: baseline;
  width: 100%;
  text-decoration: none;
}
.kp-toc-link::after {
  content: leader('.') target-counter(attr(href), page);
  flex: 1;
