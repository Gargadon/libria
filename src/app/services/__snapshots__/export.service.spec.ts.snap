    </style:style>
    <style:style style:name="Page_Break" style:family="paragraph" style:parent-style-name="Standard">
      <style:paragraph-properties fo:break-before="page"/>
    </style:style>
  </office:automatic-styles>
  <office:body>
    <office:text>
      <text:h text:outline-level="1" text:style-name="Heading_1">Primero</text:h>
<text:p text:style-name="Standard"><text:span text:style-name="Bold">Texto</text:span> con <text:span text:style-name="Italic">estilo</text:span></text:p>
<text:p text:style-name="Standard">Nota<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">Texto de nota</text:p></text:note-body></text:note>[1]</text:p>
<text:p text:style-name="Horizontal_Separator">* * *</text:p>
<text:list><text:list-item><text:p>Uno</text:p></text:list-item><text:list-item><text:p>Dos</text:p></text:list-item></text:list>
<text:p>Celda</text:p>
<text:p></text:p>
<text:p text:style-name="Page_Break"/>
<text:p text:style-name="Page_Break"/>
<text:p text:style-name="Standard">Final</text:p>
    </office:text>
  </office:body>
</office:document-content>",
  "meta.xml": "<?xml version="1.0" encoding="UTF-8"?>
<office:document-meta
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
