{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libria",
  "version": "2.0.0-beta.1",
  "identifier": "com.libria.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:4300",
    "beforeBuildCommand": "bun run build && bun run tauri:prepare",
    "frontendDist": "../dist/libria/browser"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Libria",
      "width": 1400,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "dragDropEnabled": false
    }],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Creación y maquetación de libros",
    "icon": ["../build/icon.png", "../build/icon.ico"],
    "resources": { "../build/tauri-resources/": "runtime/" },
    "fileAssociations": [{ "ext": ["libria"], "name": "Documento Libria", "mimeType": "application/x-libria", "role": "Editor" }],
    "linux": { "deb": { "depends": ["ghostscript"] } },
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["Spanish", "English"] } }
  }
}
