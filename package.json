{
  "name": "libria",
  "version": "1.5.0",
  "description": "Aplicación para la creación y maquetación de libros",
  "main": "main.js",
  "author": {
    "name": "David Kantun",
    "email": "dkantun@gmail.com"
  },
  "homepage": "https://github.com/Gargadon/libria",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gargadon/libria.git"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "ng": "ng",
    "start": "bun run ng serve --port 4300",
    "dev": "bun run ng serve --port 4300",
    "build": "bun run ng build",
    "watch": "bun run ng build --watch --configuration development",
    "test": "bun run ng test",
    "electron:dev": "concurrently --kill-others \"bun run dev\" \"wait-on http://localhost:4300 && electron . --dev --ozone-platform=x11\"",
    "electron:build": "bun run build && electron-builder",
    "download:gs": "node scripts/download-ghostscript.mjs",
    "download:gs:linux": "node scripts/download-ghostscript.mjs linux",
    "download:gs:mac": "node scripts/download-ghostscript.mjs mac",
    "download:gs:win": "node scripts/download-ghostscript.mjs win"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/hyphen": "^1.14.0",
    "blob-stream": "^0.1.3",
    "buffer": "^6.0.3",
    "dictionary-pt": "^4.0.0",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "material-symbols": "^0.44.6",
    "nspell": "^2.1.5",
    "process": "^0.11.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@types/blob-stream": "^0.1.33",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/nspell": "^2.1.6",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^9.2.1",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-en-us": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.libria.app",
    "productName": "Libria",
    "publish": [
      {
        "provider": "github",
        "owner": "Gargadon",
        "repo": "libria"
      }
    ],
    "files": [
      "dist/**/*",
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "artifactName": "${name}-${version}-linux-${arch}.${ext}",
      "category": "Office",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/bin/linux",
          "to": "gs/bin",
          "filter": ["**/*"]
        }
      ]
    },
    "deb": {
      "depends": ["ghostscript"]
    },
    "pacman": {
      "depends": ["ghostscript"]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon-512.png",
      "extraResources": [
        {
          "from": "build/bin/mac",
          "to": "gs/bin",
          "filter": ["**/*"]
        }
      ]
    },
    "win": {
      "compression": "maximum",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/bin/win",
          "to": "gs/bin",
          "filter": ["**/*"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "build/licenses",
        "to": "licenses",
        "filter": ["**/*"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "libria",
        "name": "Documento Libria",
        "description": "Archivo de proyecto Libria",
        "mimeType": "application/x-libria",
        "icon": "build/icon",
        "role": "Editor"
      }
    ],
    "electronLanguages": [
      "es",
      "es-MX",
      "en",
      "en-US",
      "it",
      "fr",
      "pt",
      "pt-BR"
    ]
  }
}
