{
  "name": "libria",
  "version": "1.0.0",
  "main": "main.js",
  "author": {
    "name": "David Kantun",
    "email": "dkantun@gmail.com"
  },
  "homepage": "https://github.com/gargadon/libria",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on http://localhost:4200 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.0",
    "blob-stream": "^0.1.3",
    "buffer": "^6.0.3",
    "docx": "^9.6.1",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "material-symbols": "^0.44.6",
    "process": "^0.11.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@types/blob-stream": "^0.1.33",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/pdfkit": "^0.17.6",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.libria.app",
    "productName": "Libria",
    "files": [
      "dist/**/*",
      "build/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "artifactName": "${name}-${version}-${target}-${arch}.${ext}",
      "compression": "maximum",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "compression": "maximum",
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "libria",
        "name": "Documento Libria",
        "description": "Archivo de proyecto Libria",
        "mimeType": "application/x-libria",
        "icon": "build/icon",
        "role": "Editor"
      }
    ],
    "electronLanguages": [
      "es",
      "es-MX",
      "en",
      "en-US"
    ]
  }
}