{
  "name": "libria",
  "version": "2.0.0-beta.1",
  "description": "Aplicación para la creación y maquetación de libros",
  "author": {
    "name": "David Kantun",
    "email": "dkantun@gmail.com"
  },
  "homepage": "https://github.com/Gargadon/libria",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gargadon/libria.git"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "ng": "ng",
    "start": "bun run ng serve --port 4300",
    "dev": "bun run ng serve --port 4300",
    "build": "bun run ng build",
    "watch": "bun run ng build --watch --configuration development",
    "test": "bun run ng test",
    "drive:bundle-credentials": "node scripts/bundle-google-drive-credentials.cjs",
    "download:gs": "node scripts/download-ghostscript.mjs",
    "download:gs:linux": "node scripts/download-ghostscript.mjs linux",
    "download:gs:mac": "node scripts/download-ghostscript.mjs mac",
    "download:gs:win": "node scripts/download-ghostscript.mjs win",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "test:desktop": "node --test scripts/pdf-export.test.mjs scripts/credential-blob.test.cjs",
    "test:drive": "cargo test --manifest-path src-tauri/Cargo.toml drive::tests",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@types/dompurify": "^3.2.0",
    "@types/hyphen": "^1.14.0",
    "@vivliostyle/cli": "^11.3.3",
    "blob-stream": "^0.1.3",
    "buffer": "^6.0.3",
    "docx": "^9.9.0",
    "dompurify": "^3.4.16",
    "file-saver": "^2.0.5",
    "hyphen": "^1.14.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "material-symbols": "^0.44.12",
    "process": "^0.11.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/blob-stream": "^0.1.33",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.1",
    "@types/pdfkit": "^0.17.6",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
