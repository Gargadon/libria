{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "libria": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "index.aff",
                "input": "node_modules/dictionary-es",
                "output": "/dictionaries/es/"
              },
              {
                "glob": "index.dic",
                "input": "node_modules/dictionary-es",
                "output": "/dictionaries/es/"
              },
              {
                "glob": "index.aff",
                "input": "node_modules/dictionary-en",
                "output": "/dictionaries/en/"
              },
              {
                "glob": "index.dic",
                "input": "node_modules/dictionary-en",
                "output": "/dictionaries/en/"
              },
              {
                "glob": "index.aff",
                "input": "node_modules/dictionary-fr",
                "output": "/dictionaries/fr/"
              },
              {
                "glob": "index.dic",
                "input": "node_modules/dictionary-fr",
                "output": "/dictionaries/fr/"
              },
              {
                "glob": "index.aff",
                "input": "node_modules/dictionary-it",
                "output": "/dictionaries/it/"
              },
              {
                "glob": "index.dic",
                "input": "node_modules/dictionary-it",
                "output": "/dictionaries/it/"
              }
            ],
            "styles": [
              "src/styles.scss",
              "public/fonts.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "baseHref": "./",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "libria:build:production"
            },
            "development": {
              "buildTarget": "libria:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}